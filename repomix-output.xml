    <script>
      // Game Settings & States (Hanya 4 Tahapan Piksel)
      const STORAGE_KEY = "pixel_guess_slides_v1";
      const PIXEL_STEPS = [70, 30, 10, 1]; // 4 Tingkat Kejelasan Piksel

      let slides = []; // Array of { id, url, name }
      let currentSlideIdx = 0;
      let currentStepIdx = 0;
      let isAnswerRevealed = false;

      // Save & Load LocalStorage
      function saveSlidesToLocalStorage() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(slides));
        } catch (e) {
          console.error("Gagal menyimpan ke LocalStorage:", e);
          showToast("Peringatan: Penyimpanan browser penuh!");
        }
      }

      function loadSlidesFromLocalStorage() {
        try {
          const data = localStorage.getItem(STORAGE_KEY);
          if (data) {
            const parsed = JSON.parse(data);
            if (Array.isArray(parsed) && parsed.length > 0) {
              slides = parsed;
              return true;
            }
          }
        } catch (e) {
          console.error("Gagal membaca LocalStorage:", e);
        }
        return false;
      }

      // Compress image to Base64 Data URL to fit efficiently in localStorage
      function fileToBase64DataUrl(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (event) => {
            const img = new Image();
            img.onload = () => {
              const canvas = document.createElement("canvas");
              const maxDim = 1200;
              let width = img.width;
              let height = img.height;

              if (width > maxDim || height > maxDim) {
                if (width > height) {
                  height = Math.round((height * maxDim) / width);
                  width = maxDim;
                } else {
                  width = Math.round((width * maxDim) / height);
                  height = maxDim;
                }
              }

              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              ctx.drawImage(img, 0, 0, width, height);

              const dataUrl = canvas.toDataURL("image/jpeg", 0.82);
              resolve(dataUrl);
            };
            img.onerror = reject;
            img.src = event.target.result;
          };
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });
      }

      // Render Canvas Function
      function renderCanvas() {
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        if (slides.length === 0) {
          document.getElementById("noImageOverlay").classList.remove("hidden");
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          return;
        } else {
          document.getElementById("noImageOverlay").classList.add("hidden");
        }

        const currentSlide = slides[currentSlideIdx];
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.src = currentSlide.url;

        img.onload = () => {
          const container = canvas.parentElement;
          const targetWidth = container.clientWidth;
          const targetHeight = container.clientHeight || 500;

          canvas.width = targetWidth;
          canvas.height = targetHeight;

          const imgRatio = img.naturalWidth / img.naturalHeight;
          const containerRatio = targetWidth / targetHeight;

          let drawWidth, drawHeight, offsetX, offsetY;
          if (imgRatio > containerRatio) {
            drawWidth = targetWidth;
            drawHeight = targetWidth / imgRatio;
            offsetX = 0;
            offsetY = (targetHeight - drawHeight) / 2;
          } else {
            drawHeight = targetHeight;
            drawWidth = targetHeight * imgRatio;
            offsetX = (targetWidth - drawWidth) / 2;
            offsetY = 0;
          }

          ctx.clearRect(0, 0, canvas.width, canvas.height);

          const currentPixelSize = PIXEL_STEPS[currentStepIdx];

          if (currentPixelSize <= 1) {
            // Crisp original image
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = "high";
            ctx.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
          } else {
            // Pixelated effect via offscreen downscaling & upscaling
            const offscreen = document.createElement("canvas");
            const offCtx = offscreen.getContext("2d");

            const scaledW = Math.max(
              1,
              Math.floor(drawWidth / currentPixelSize),
            );
            const scaledH = Math.max(
              1,
              Math.floor(drawHeight / currentPixelSize),
            );

            offscreen.width = scaledW;
            offscreen.height = scaledH;

            offCtx.imageSmoothingEnabled = true;
            offCtx.drawImage(img, 0, 0, scaledW, scaledH);

            ctx.imageSmoothingEnabled = false; // Nearest neighbor pixel blocks
            ctx.drawImage(
              offscreen,
              0,
              0,
              scaledW,
              scaledH,
              offsetX,
              offsetY,
              drawWidth,
              drawHeight,
            );
          }

          // Update UI Information
          document.getElementById("currentSlideIndex").textContent =
            currentSlideIdx + 1;
          document.getElementById("totalSlidesCount").textContent =
            slides.length;
          document.getElementById("btnImageCount").textContent = slides.length;
          document.getElementById("modalImageListCount").textContent =
            slides.length;

          document.getElementById("pixelSlider").value = currentStepIdx;
          document.getElementById("pixelFactorText").textContent =
            currentStepIdx + 1 + "/4";

          document.getElementById("answerText").textContent =
            currentSlide.name || "Gambar #" + (currentSlideIdx + 1);
        };
      }

      // File Selection Handler (Mass upload 10-100 files)
      async function handleFileSelect(e) {
        const files = Array.from(e.target.files || []);
        if (!files || files.length === 0) return;

        showToast("Memproses & menyimpan foto...");

        const newSlides = [];
        for (const file of files) {
          try {
            const base64Url = await fileToBase64DataUrl(file);
            const cleanName = file.name
              .replace(/\.[^/.]+$/, "")
              .replace(/[-_]/g, " ");
            newSlides.push({
              id: Date.now() + "_" + Math.random().toString(36).substring(2, 7),
              url: base64Url,
              name: capitalizeWords(cleanName),
            });
          } catch (err) {
            console.error("Gagal memproses file:", file.name, err);
          }
        }

        slides = [...slides, ...newSlides];
        saveSlidesToLocalStorage();
        updateImageListGrid();
        renderCanvas();
        showToast(`${newSlides.length} foto berhasil tersimpan di browser!`);
      }

      // Drag & Drop
      const dropZone = document.getElementById("dropZone");
      ["dragenter", "dragover"].forEach((eventName) => {
        dropZone.addEventListener(
          eventName,
          (e) => {
            e.preventDefault();
            dropZone.classList.add("border-indigo-400", "bg-slate-800/80");
          },
          false,
        );
      });

      ["dragleave", "drop"].forEach((eventName) => {
        dropZone.addEventListener(
          eventName,
          (e) => {
            e.preventDefault();
            dropZone.classList.remove("border-indigo-400", "bg-slate-800/80");
          },
          false,
        );
      });

      dropZone.addEventListener("drop", (e) => {
        const files = e.dataTransfer.files;
        if (files && files.length > 0) {
          handleFileSelect({ target: { files: files } });
        }
      });

      function capitalizeWords(str) {
        return str.replace(/\b\w/g, (l) => l.toUpperCase());
      }

      // Render Thumbnails inside Upload Modal
      function updateImageListGrid() {
        const grid = document.getElementById("imageListGrid");
        grid.innerHTML = "";

        slides.forEach((slide, index) => {
          const card = document.createElement("div");
          card.className = `p-2 rounded-xl bg-slate-900 border flex items-center gap-2.5 ${index === currentSlideIdx ? "border-indigo-500 ring-1 ring-indigo-500" : "border-slate-800"}`;

          card.innerHTML = `
                    <img src="${slide.url}" class="w-10 h-10 object-cover rounded-lg border border-slate-700">
                    <div class="flex-1 min-w-0">
                        <input type="text" value="${slide.name}" onchange="updateSlideName('${slide.id}', this.value)" 
                            class="w-full bg-slate-800 border border-slate-700 text-xs rounded px-2 py-0.5 text-white focus:outline-none focus:border-indigo-500 truncate">
                        <span class="text-[10px] text-slate-500">Foto #${index + 1}</span>
                    </div>
                    <button onclick="removeSlide('${slide.id}')" class="text-slate-500 hover:text-rose-400 p-1">
                        <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                `;
          grid.appendChild(card);
        });
      }

      function updateSlideName(id, newName) {
        const slide = slides.find((s) => s.id === id);
        if (slide) {
          slide.name = newName;
          if (slides[currentSlideIdx] && slides[currentSlideIdx].id === id) {
            document.getElementById("answerText").textContent = newName;
          }
          saveSlidesToLocalStorage();
        }
      }

      function removeSlide(id) {
        slides = slides.filter((s) => s.id !== id);
        if (currentSlideIdx >= slides.length) {
          currentSlideIdx = Math.max(0, slides.length - 1);
        }
        saveSlidesToLocalStorage();
        updateImageListGrid();
        renderCanvas();
      }

      function clearAllImages() {
        slides = [];
        currentSlideIdx = 0;
        localStorage.removeItem(STORAGE_KEY);
        updateImageListGrid();
        renderCanvas();
        showToast("Semua foto & data lokal dihapus.");
      }

      function loadDefaultSamples() {
        slides = [
          {
            id: "sample1",
            url: "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=800&auto=format&fit=crop",
            name: "Kucing Imut",
          },
          {
            id: "sample2",
            url: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&auto=format&fit=crop",
            name: "Pantai Tropis",
          },
          {
            id: "sample3",
            url: "https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?w=800&auto=format&fit=crop",
            name: "Mobil Sport Merah",
          },
          {
            id: "sample4",
            url: "https://images.unsplash.com/photo-1513104890138-7c749659a591?w=800&auto=format&fit=crop",
            name: "Pizza Keju",
          },
          {
            id: "sample5",
            url: "https://images.unsplash.com/photo-1543610892-0b1f7e6d8ac1?w=800&auto=format&fit=crop",
            name: "Monumen Nasional",
          },
        ];
        currentSlideIdx = 0;
        currentStepIdx = 0;
        saveSlidesToLocalStorage();
        updateImageListGrid();
        renderCanvas();
        showToast("5 Foto contoh dimuat & disimpan!");
      }

      // Gameplay Actions
      function revealNextStep() {
        if (slides.length === 0) return;
        if (currentStepIdx < PIXEL_STEPS.length - 1) {
          currentStepIdx++;
          renderCanvas();
        } else {
          nextSlide();
        }
      }

      function stepBackward() {
        if (slides.length === 0) return;
        if (currentStepIdx > 0) {
          currentStepIdx--;
          renderCanvas();
        } else {
          prevSlide();
        }
      }

      function toggleAnswer() {
        if (slides.length === 0) return;
        isAnswerRevealed = !isAnswerRevealed;
        const overlay = document.getElementById("answerOverlay");

        if (isAnswerRevealed) {
          overlay.classList.remove("translate-y-full");
          currentStepIdx = PIXEL_STEPS.length - 1; // Unblur image on answer reveal
          renderCanvas();
        } else {
          overlay.classList.add("translate-y-full");
        }
      }

      function hideAnswer() {
        isAnswerRevealed = false;
        document
          .getElementById("answerOverlay")
          .classList.add("translate-y-full");
      }

      function nextSlide() {
        if (slides.length === 0) return;
        currentSlideIdx = (currentSlideIdx + 1) % slides.length;
        currentStepIdx = 0;
        hideAnswer();
        renderCanvas();
      }

      function prevSlide() {
        if (slides.length === 0) return;
        currentSlideIdx = (currentSlideIdx - 1 + slides.length) % slides.length;
        currentStepIdx = 0;
        hideAnswer();
        renderCanvas();
      }

      // Slider Input Event
      document.getElementById("pixelSlider").addEventListener("input", (e) => {
        currentStepIdx = parseInt(e.target.value);
        renderCanvas();
      });

      // Modals & Fullscreen Helpers
      function toggleUploadModal() {
        const modal = document.getElementById("uploadModal");
        const content = document.getElementById("uploadModalContent");
        if (modal.classList.contains("opacity-0")) {
          modal.classList.remove("opacity-0", "pointer-events-none");
          content.classList.remove("scale-95");
        } else {
          modal.classList.add("opacity-0", "pointer-events-none");
          content.classList.add("scale-95");
        }
      }

      function toggleFullscreen() {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(() => {
            showToast("Gagal fullscreen");
          });
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen();
          }
        }
      }

      function showToast(msg) {
        const toast = document.getElementById("toast");
        document.getElementById("toastMessage").textContent = msg;
        toast.classList.remove("translate-y-10", "opacity-0");
        setTimeout(() => {
          toast.classList.add("translate-y-10", "opacity-0");
        }, 2000);
      }

      // Host Keyboard Shortcuts Listener
      window.addEventListener("keydown", (e) => {
        if (["INPUT", "TEXTAREA"].includes(document.activeElement.tagName))
          return;

        if (e.code === "Space" || e.key === "ArrowRight") {
          e.preventDefault();
          revealNextStep();
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          stepBackward();
        } else if (e.key === "a" || e.key === "A") {
          toggleAnswer();
        } else if (e.key === "f" || e.key === "F") {
          toggleFullscreen();
        }
      });

      // Window Resize Handler
      window.addEventListener("resize", () => {
        renderCanvas();
      });

      // Initial Load Routine
      window.onload = function () {
        const hasData = loadSlidesFromLocalStorage();
        if (!hasData) {
          loadDefaultSamples();
        } else {
          currentSlideIdx = 0;
          currentStepIdx = 0;
          updateImageListGrid();
          renderCanvas();
          showToast("Foto tersimpan otomatis dimuat dari browser!");
        }
      };
    </script>
  </body>
</html>
