    </script>
    <script>
      let order = [], idx = 0, flipped = false, isAnim = false, seen = 0;

      const els = {
        home: document.getElementById("home-screen"),
        game: document.getElementById("game-screen"),
        flip: document.getElementById("flip-card"),
        tanya: document.getElementById("pertanyaan"),
        kalimat: document.getElementById("kalimat-lengkap"),
        explainB: document.getElementById("explain-back"),
        counter: document.getElementById("counter-pill"),
        qBoxF: document.getElementById("q-box-front"),
      };

      function shuffle(a) { return [...a].sort(() => Math.random() - 0.5); }

      function startGame() {
        if (typeof DATA === "undefined" || !Array.isArray(DATA) || DATA.length === 0) {
          alert("Gagal memuat soal (DATA belum tersedia). Buka via http://.../tebak_sirah/ atau cek file soal.js");
          return;
        }
        order = shuffle(DATA);
        idx = 0; seen = 0;
        flipped = false;
        els.flip.classList.remove("flipped");
        switchScreen(els.home, els.game);
        setTimeout(() => loadQuestion(), 300);
      }

      function goHome() {
        if (isAnim) return;
        flipped = false;
        els.flip.classList.remove("flipped");
        switchScreen(els.game, els.home);
      }

      function escapeHtml(s) {
        return String(s)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
      }
      // Isi titik-titik (....) dengan jawaban, di-highlight hijau
      function completedHTML(q) {
        const ans = '<span class="jawab-inline">' + escapeHtml(q.jawaban) + "</span>";
        const safe = escapeHtml(q.pertanyaan);
        if (/\.{3,}/.test(safe)) return safe.replace(/\.{3,}/, ans);
        return safe + " " + ans;
      }
      function completedText(q) {
        if (/\.{3,}/.test(q.pertanyaan)) return q.pertanyaan.replace(/\.{3,}/, q.jawaban);
        return q.pertanyaan + " " + q.jawaban;
      }

      function loadQuestion() {
        const q = order[idx];
        els.tanya.textContent = q.pertanyaan;
        seen++;
        els.counter.textContent = seen + " • No." + q.id;
        // back: tampilkan kalimat lengkap (titik-titik sudah terisi jawaban)
        els.kalimat.innerHTML = completedHTML(q);
        // penjelasan hanya tampil kalau ada info TAMBAHAN di luar kalimat lengkap
        const norm = (s) => (s || "").trim().replace(/[.]+$/, "").trim().toLowerCase();
        if (q.penjelasan && norm(q.penjelasan) !== norm(completedText(q))) {
          els.explainB.textContent = q.penjelasan;
          els.explainB.style.display = "";
        } else {
          els.explainB.textContent = "";
          els.explainB.style.display = "none";
        }
        els.qBoxF.classList.remove("spinning");
      }

      function revealAnswer() {
        if (flipped || isAnim) return;
        flipped = true;
        els.flip.classList.add("flipped");
        launchConfetti();
      }
      function hideAnswer() {
        if (!flipped || isAnim) return;
        flipped = false;
        els.flip.classList.remove("flipped");
      }

      function spinNext() {
        if (isAnim) return;
        isAnim = true;
        if (flipped) { flipped = false; els.flip.classList.remove("flipped"); }
        const box = els.qBoxF;
        box.classList.add("spinning");
        let c = 0, max = 12;
        const iv = setInterval(() => {
          const r = DATA[Math.floor(Math.random() * DATA.length)];
          els.tanya.textContent = r.pertanyaan;
          els.tanya.style.opacity = 0.3 + Math.random() * 0.4;
          c++;
          if (c >= max) {
            clearInterval(iv);
            idx = (idx + 1) % order.length;
            if (idx === 0) order = shuffle(DATA);
            els.tanya.style.opacity = 1;
            loadQuestion();
            box.classList.remove("spinning");
            isAnim = false;
          }
        }, 65);
      }

      function switchScreen(hide, show) {
        hide.style.opacity = 0;
        hide.style.transform = "translateY(-20px)";
        setTimeout(() => {
          hide.classList.remove("active");
          show.classList.add("active");
          void show.offsetWidth;
          show.style.opacity = 1;
          show.style.transform = "translateY(0)";
        }, 200);
      }

      function launchConfetti() {
        const c = document.getElementById("confetti");
        c.innerHTML = "";
        const cols = ["#FFD23F", "#22c55e", "#3b82f6", "#ff4d4d", "#a78bfa", "#f59e0b"];
        for (let i = 0; i < 18; i++) {
          const e = document.createElement("i");
          e.style.left = Math.random() * 100 + "%";
          e.style.background = cols[Math.floor(Math.random() * cols.length)];
          e.style.transform = `rotate(${Math.random() * 360}deg)`;
          e.style.animationDelay = Math.random() * 0.25 + "s";
          e.style.borderRadius = Math.random() > 0.5 ? "50%" : "4px";
          c.appendChild(e);
        }
        setTimeout(() => (c.innerHTML = ""), 1200);
      }

      function triggerSim(el, fn) {
        el.classList.add("hover-sim");
        setTimeout(() => { el.classList.remove("hover-sim"); fn(); }, 150);
      }

      document.addEventListener("keydown", (e) => {
        if (isAnim) return;
        const homeActive = els.home.classList.contains("active");
        if (homeActive) {
          if (e.key === "Enter" || e.code === "Space") {
            e.preventDefault();
            triggerSim(document.getElementById("card-start"), () => startGame());
          }
        } else {
          if (e.code === "Space") { e.preventDefault(); flipped ? hideAnswer() : revealAnswer(); }
          if (e.key === "Enter") { e.preventDefault(); spinNext(); }
          if (e.key === "Escape") { e.preventDefault(); goHome(); }
        }
      });
    </script>
  </body>
</html>
</file>

