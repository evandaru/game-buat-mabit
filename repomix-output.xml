<file path="detektif_tajwid/game.html">
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detektif Tajwid — Misteri Nun Sakinah & Tanwin</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --black: #111;
        --white: #fff;
        --off: #fdfdf7;
        --yellow: #ffd23f;
        --green: #2ecc71;
        --red: #ff4d4d;
        --blue: #3b82f6;
      }
      html,
      body {
        height: 100%;
      }
      body {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          Segoe UI,
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        background-color: #fdfdf7;
        background-image: radial-gradient(
          circle,
          #ddd 1.6px,
          transparent 1.6px
        );
        background-size: 22px 22px;
        color: var(--black);
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
      }
      a {
        color: inherit;
      }
      .topbar {
        width: 100%;
        text-align: center;
        padding: 18px 0 6px;
        font-weight: 900;
        letter-spacing: 0.14em;
        font-size: 13px;
      }
      .container {
        width: min(860px, 94vw);
        margin: 0 auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 16px 0 28px;
      }
      .card {
        background: var(--white);
        border: 4px solid var(--black);
        border-radius: 22px;
        box-shadow: 8px 8px 0 var(--black);
      }
      .view {
        width: 100%;
        display: none;
        flex-direction: column;
        align-items: center;
      }
      .view.active {
        display: flex;
      }
      .h1 {
        font-weight: 900;
        text-align: center;
        letter-spacing: 0.08em;
        line-height: 1;
      }
      .h1-main {
        font-size: clamp(32px, 6vw, 56px);
      }
      .h1-sub1 {
        font-size: clamp(14px, 2.2vw, 18px);
        margin-top: 10px;
        letter-spacing: 0.18em;
      }
      .h1-sub2 {
        font-size: clamp(14px, 2.2vw, 18px);
        letter-spacing: 0.18em;
      }
      .tagline {
        margin-top: 12px;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.08em;
        opacity: 0.85;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--white);
        border: 4px solid var(--black);
        border-radius: 16px;
        box-shadow: 6px 6px 0 var(--black);
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 16px 28px;
        font-size: clamp(14px, 2vw, 18px);
        cursor: pointer;
        user-select: none;
        transition:
          transform 0.08s,
          box-shadow 0.08s,
          background 0.12s;
        min-width: 260px;
      }
      .btn:hover {
        transform: translate(-3px, -3px);
        box-shadow: 9px 9px 0 var(--black);
      }
      .btn:active {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 var(--black);
      }
      .btn.primary {
        background: var(--yellow);
      }
      .btn.dark {
        background: var(--black);
        color: #fff;
        box-shadow: 6px 6px 0 #000;
      }
      .btn.small {
        min-width: 160px;
        padding: 12px 18px;
        font-size: 14px;
        border-radius: 14px;
      }
      .btn.choice {
        min-width: 0;
        width: 100%;
        padding: 18px 10px;
        font-size: clamp(15px, 2vw, 19px);
        border-radius: 18px;
      }
      .btn.choice.selected {
        outline: 4px solid var(--blue);
        outline-offset: 0;
      }
      .btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
        box-shadow: 6px 6px 0 var(--black);
      }
      .stack {
        display: flex;
        flex-direction: column;
        gap: 14px;
        align-items: center;
        margin-top: 18px;
      }
      .menu-card {
        width: min(560px, 92vw);
        padding: 34px 28px;
        text-align: center;
      }
      .game-wrap {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
      }
      .status-row {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .pill {
        border: 3px solid var(--black);
        border-radius: 999px;
        padding: 6px 14px;
        font-weight: 900;
        font-size: 12px;
        letter-spacing: 0.08em;
        background: var(--white);
        box-shadow: 4px 4px 0 var(--black);
      }
      .pill.yellow {
        background: var(--yellow);
      }
      .hearts {
        font-size: 18px;
        letter-spacing: 2px;
      }
      .hearts .dead {
        opacity: 0.22;
        filter: grayscale(1);
      }
      .ayat-card {
        width: min(760px, 98%);
        padding: 28px 18px;
        text-align: center;
        position: relative;
      }
      .badge {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--black);
        color: #fff;
        border-radius: 999px;
        padding: 5px 14px;
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.14em;
        white-space: nowrap;
      }
      .ayat-arabic {
        font-family: "Scheherazade New", "Traditional Arabic", serif;
        font-size: clamp(36px, 6vw, 54px);
        line-height: 1.6;
        direction: rtl;
        word-spacing: 0.2em;
      }
      .words {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 10px;
        direction: rtl;
      }
      .word {
        font-family: "Scheherazade New", serif;
        font-size: clamp(22px, 3.6vw, 34px);
        border: 3px solid transparent;
        border-radius: 14px;
        padding: 6px 12px;
        cursor: pointer;
        background: #fff;
        transition: all 0.12s;
        direction: rtl;
        line-height: 1.4;
      }
      .word:hover {
        border-color: var(--black);
        transform: translateY(-2px);
        box-shadow: 4px 4px 0 var(--black);
      }
      .word.selected {
        border-color: var(--black);
        background: var(--yellow);
        box-shadow: 6px 6px 0 var(--black);
        transform: translateY(-1px);
      }
      .word.correct-flash {
        animation: flash 0.5s;
      }
      @keyframes flash {
        0% {
          background: var(--yellow);
        }
        50% {
          background: #b8f5b8;
        }
        100% {
          background: var(--yellow);
        }
      }
      .hint-panel {
        width: min(760px, 98%);
        padding: 14px 16px;
        text-align: center;
      }
      .hint-title {
        font-weight: 900;
        letter-spacing: 0.1em;
        font-size: 12px;
      }
      .hint-desc {
        font-size: 13px;
        font-weight: 700;
        margin-top: 4px;
        line-height: 1.5;
        opacity: 0.9;
      }
      .choices {
        width: min(760px, 98%);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }
      .evidence {
        width: min(760px, 98%);
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
      }
      .evidence-label {
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.12em;
      }
      .evidence-letters {
        font-family: "Scheherazade New", serif;
        font-size: 22px;
        letter-spacing: 0.18em;
        direction: rtl;
      }
      .evidence-letters span {
        display: inline-block;
        border: 2px solid var(--black);
        border-radius: 8px;
        padding: 2px 7px;
        background: var(--white);
        box-shadow: 2px 2px 0 var(--black);
      }
      .kbd-hint {
