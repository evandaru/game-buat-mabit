<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Slide Inspektor Tajwid - Juz 30</title>
    <script>
      // Normalisasi trailing slash agar path relatif seperti 'ayat.js' terbaca dengan benar
      if (
        !location.pathname.endsWith("/") &&
        !location.pathname.split("/").pop().includes(".")
      ) {
        location.replace(
          location.pathname + "/" + location.search + location.hash
        );
      }
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Scheherazade+New:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #ffffff;
        --black: #000;
        --yellow: #ffd23f;
        --green: #22c55e;
        --red: #ff4d4d;
        --blue: #3b82f6;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Outfit", sans-serif;
        user-select: none;
      }
      body {
        background: var(--bg);
        color: var(--black);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow-x: hidden;
        overflow-y: auto;
        position: relative;
        padding: 16px 0 80px;
      }
      body::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(#d1d5db 1px, transparent 1px);
        background-size: 28px 28px;
        opacity: 0.5;
        z-index: 0;
      }
      #app {
        position: relative;
        z-index: 10;
        width: 96%;
        max-width: 1100px;
        text-align: center;
      }
      .screen {
        display: none;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .screen.active {
        display: block;
        opacity: 1;
        transform: translateY(0);
      }
      .top-tag {
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.18em;
        opacity: 0.7;
        margin-bottom: 10px;
      }
      .title {
        font-size: clamp(32px, 5.5vw, 58px);
        font-weight: 900;
        letter-spacing: 0.06em;
        line-height: 1;
      }
      .title span {
        background: var(--yellow);
        padding: 2px 12px;
        border: 3px solid var(--black);
        border-radius: 12px;
        box-shadow: 4px 4px 0 var(--black);
        display: inline-block;
        transform: rotate(-1deg);
      }
      .subtitle {
        font-size: clamp(11px, 1.6vw, 14px);
        font-weight: 700;
        letter-spacing: 0.12em;
        color: #4b5563;
        margin-top: 10px;
      }
      .pills-row {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 12px;
      }
      .pill-mini {
        border: 3px solid var(--black);
        border-radius: 999px;
        padding: 6px 14px;
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.08em;
        background: #fff;
        box-shadow: 3px 3px 0 var(--black);
      }
      .pill-mini.yellow {
        background: var(--yellow);
      }
      .cards-container {
        display: flex;
        gap: 4vw;
        justify-content: center;
        padding: 2rem 1rem;
        flex-wrap: wrap;
      }
      .card-select {
        flex: 1;
        min-width: 280px;
        max-width: 560px;
        height: 42vh;
        min-height: 340px;
        background: #fff;
        border: 4px solid var(--black);
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 12px 12px 0 var(--black);
        transition: all 0.2s ease;
      }
      .card-select:hover,
      .card-select.hover-sim {
        transform: translate(-6px, -6px);
        box-shadow: 18px 18px 0 var(--black);
        background: #f9fafb;
      }
      .card-select:active {
        transform: translate(6px, 6px);
        box-shadow: 0 0 0 var(--black);
      }
      .card-select h2 {
        font-size: clamp(36px, 5vw, 56px);
        font-weight: 900;
        line-height: 1;
      }
      .card-select .arab {
        font-family: "Scheherazade New", serif;
        font-size: 30px;
        margin-top: 8px;
        letter-spacing: 0.12em;
      }
      .card-select .desc {
        font-size: 13px;
        font-weight: 700;
        color: #6b7280;
        margin-top: 10px;
        max-width: 80%;
        line-height: 1.4;
      }
      .badge-card {
        position: absolute;
        top: 14px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 0.1em;
        border: 3px solid var(--black);
        background: var(--black);
        color: #fff;
      }
      .badge-card.yellow {
        background: var(--yellow);
        color: var(--black);
      }
      .card-select small {
        margin-top: 12px;
        font-size: 11px;
        letter-spacing: 0.08em;
        font-weight: 800;
        opacity: 0.6;
      }
      /* FLIP */
      .flip-wrapper {
        perspective: 1200px;
        width: min(900px, 98%);
        margin: 28px auto 0;
        overflow: visible;
        padding-top: 10px;
      }
      .flip-card {
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.75s cubic-bezier(0.68, -0.35, 0.265, 1.55);
      }
      .flip-card.flipped {
        transform: rotateY(180deg);
      }
      .face {
        backface-visibility: hidden;
        position: relative;
      }
      .face.back {
        position: absolute;
        inset: 0;
        transform: rotateY(180deg);
      }
      .question-box {
        background: #fff;
        border: 4px solid var(--black);
        border-radius: 24px;
        padding: 42px 18px 24px;
        min-height: 380px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 14px 14px 0 var(--black);
        overflow: visible;
        position: relative;
      }
      .type-badge {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%, -50%);
        padding: 8px 22px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0.12em;
        background: var(--black);
        color: #fff;
        border: 3px solid var(--black);
        white-space: nowrap;
        z-index: 5;
      }
      .type-badge.nun {
        background: var(--blue);
      }
      .type-badge.idzhar {
        background: #f59e0b;
        color: #000;
      }
      .ayat-arab {
        display: none !important;
      }
      .words {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 18px;
        direction: rtl;
      }
      .word {
        font-family: "Scheherazade New", serif;
        font-size: clamp(32px, 4.6vw, 48px);
        padding: 4px 10px;
        border-radius: 14px;
        border: 3px solid transparent;
        background: transparent;
        cursor: pointer;
        transition: all 0.18s;
        direction: rtl;
        line-height: 1.8;
      }
      .word:hover {
        border-color: var(--black);
        transform: translateY(-2px);
        box-shadow: 4px 4px 0 var(--black);
      }
      .word.correct {
        border-color: var(--black);
        background: var(--green);
        color: #fff;
        box-shadow: 5px 5px 0 var(--black);
        animation: pop 0.35s ease;
      }
      .word.wrong {
        border-color: var(--red);
        background: #ffe4e6;
      }
      .word.highlight-nun {
        border-color: var(--black);
        background: var(--yellow);
        box-shadow: 4px 4px 0 var(--black);
        animation: pop 0.4s ease;
      }
      .word.highlight-idzhar {
        border-color: var(--black);
        background: var(--green);
        color: #fff;
        box-shadow: 4px 4px 0 var(--black);
        animation: pop 0.4s ease;
      }
      .word.dim {
        opacity: 0.35;
      }
      @keyframes pop {
        0% {
          transform: scale(0.92);
        }
        60% {
          transform: scale(1.05);
        }
        100% {
          transform: scale(1);
        }
      }
      .surah {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.1em;
        opacity: 0.6;
        margin-top: 10px;
      }
      .instr {
        display: none !important;
      }
      .instr.answer {
        background: var(--yellow);
        border-style: solid;
        border-color: var(--black);
      }
      .explain {
        margin-top: 10px;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.5;
        opacity: 0.9;
        max-width: 700px;
      }
      .explain b {
        font-weight: 900;
      }
      .btn-row {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 18px;
      }
      .btn {
        padding: 13px 26px;
        font-size: 14px;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border: 4px solid var(--black);
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 6px 6px 0 var(--black);
        transition: all 0.15s;
        background: #fff;
      }
      .btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 8px 8px 0 var(--black);
      }
      .btn:active {
        transform: translate(3px, 3px);
        box-shadow: 0 0 0 var(--black);
      }
      .btn.primary {
        background: var(--yellow);
      }
      .btn.green {
        background: var(--green);
        color: #fff;
      }
      .controls-hint {
        position: fixed;
        bottom: 14px;
        left: 50%;
        transform: translateX(-50%);
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        z-index: 10;
        text-align: center;
        white-space: nowrap;
        background: rgba(255, 255, 255, 0.9);
        padding: 8px 14px;
        border-radius: 999px;
        border: 2px solid #e5e7eb;
      }
      kbd {
        background: #fff;
        padding: 2px 7px;
        border-radius: 6px;
        border: 2px solid #6b7280;
        font-family: monospace;
        color: #111;
        margin: 0 2px;
        font-weight: 900;
      }
      .spinning {
        animation: spinBlur 0.65s ease;
      }
      @keyframes spinBlur {
        0% {
          transform: rotateY(0) scale(1);
          filter: blur(0);
        }
        30% {
          transform: rotateY(180deg) scale(0.92);
          filter: blur(4px);
          opacity: 0.6;
        }
        60% {
          transform: rotateY(540deg) scale(1.02);
          filter: blur(2px);
        }
        100% {
          transform: rotateY(720deg) scale(1);
          filter: blur(0);
        }
      }
      .shake {
        animation: shake 0.3s;
      }
      @keyframes shake {
        0%,
        100% {
          transform: translateX(0);
        }
        25% {
          transform: translateX(-6px);
        }
        75% {
          transform: translateX(6px);
        }
      }
      .confetti {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        border-radius: 24px;
      }
      .confetti i {
        position: absolute;
        width: 10px;
        height: 10px;
        top: -10px;
        animation: fall 900ms linear forwards;
      }
      @keyframes fall {
        to {
          transform: translateY(500px) rotate(720deg);
        }
      }
      .progress {
        display: none !important;
      }
      .progress-bar {
        height: 100%;
        background: var(--black);
        width: 0;
        transition: width 0.4s;
      }
      @media (max-width: 700px) {
        .card-select {
          width: 92vw;
          min-height: 250px;
          height: 32vh;
        }
        .question-box {
          min-height: 400px;
          padding: 26px 12px;
        }
        .controls-hint {
          font-size: 10px;
          bottom: 6px;
        }
      }
    </style>
  </head>
  <body>
    <div id="app">
      <!-- HOME: SATU KARTU SAJA -->
      <div id="home-screen" class="screen active">
        <div style="margin-bottom: 10px">
          <div class="top-tag">SLIDE INSPEKTOR TAJWID • JUZ 30</div>
          <div class="title">INSPEKTOR <span>TAJWID</span></div>
          <div class="subtitle">
            Satu ayat panjang • Soal acak: Cari Nun Sakinah atau Cari Idzhar •
            Untuk Anak SD
          </div>
          <div class="pills-row">
            <div class="pill-mini yellow">6 Huruf Idzhar: ء ه ع ح غ خ</div>
            <div class="pill-mini">Nun Sakinah: نْ • Tanwin: ـً ـٍ ـٌ</div>
          </div>
        </div>
        <div class="cards-container" style="justify-content: center">
          <div class="card-select" id="card-start" onclick="startGame()">
            <div class="badge-card yellow">JUZ 30 • ACAK</div>
            <h2>MULAI</h2>
            <div class="arab">اِبْدَأْ</div>
            <div class="desc">
              Satu ayat tampil.<br />Soal random: <b>“Cari Nun Sakinah”</b> atau
              <b>“Cari Idzhar”</b>
            </div>
            <small>Klik / Tekan Spasi / Enter</small>
          </div>
        </div>
        <div
          style="
            margin-top: 8px;
            font-size: 11px;
            font-weight: 700;
            opacity: 0.5;
            letter-spacing: 0.06em;
          "
        >
          Mode proyektor • Slide tunggal
        </div>
      </div>

      <!-- GAME: SATU AYAT -->
      <div id="game-screen" class="screen">
        <div class="flip-wrapper" id="flip-wrapper">
          <div class="flip-card" id="flip-card">
            <div class="face front">
              <div class="question-box" id="q-box-front">
                <div class="type-badge" id="mode-badge">CARI NUN SAKINAH</div>
                <div style="position: absolute; top: 14px; right: 14px">
                  <span
                    class="pill-mini"
                    id="counter-pill"
                    style="font-size: 11px; padding: 5px 10px"
                    >1 / 14</span
                  >
                </div>
                <div class="ayat-arab" id="ayat-text">...</div>
                <div class="words" id="words-front"></div>
                <div class="surah" id="surah-front">QS. —</div>
                <div class="instr" id="instr-front">
                  👆 Sentuh kata yang ada نْ / tanwin (ـً ـٍ ـٌ)
                </div>
                <div class="btn-row">
                  <button
                    class="btn primary"
                    id="btn-reveal"
                    onclick="revealAnswer()"
                  >
                    LIHAT JAWABAN ✨
                  </button>
                  <button class="btn" onclick="spinNext()">SOAL ACAK 🎲</button>
                </div>
              </div>
            </div>
            <div class="face back">
              <div
                class="question-box"
                id="q-box-back"
                style="background: #fdfdf7"
              >
                <div
                  class="type-badge"
                  id="mode-badge-back"
                  style="background: var(--green)"
                >
                  JAWABAN
                </div>
                <div class="confetti" id="confetti"></div>
                <div class="ayat-arab" id="ayat-text-back">...</div>
                <div class="words" id="words-back"></div>
                <div class="surah" id="surah-back">QS. —</div>
                <div class="instr answer" id="instr-back">
                  ✅ Yang berwarna = jawabannya!
                </div>
                <div class="explain" id="explain-back"></div>
                <div class="btn-row">
                  <button class="btn green" onclick="spinNext()">
                    SOAL BERIKUTNYA →
                  </button>
                  <button class="btn" onclick="hideAnswer()">
                    KEMBALI KE SOAL
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="progress">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
        <button
          class="btn"
          style="margin-top: 12px; padding: 10px 18px; font-size: 12px"
          onclick="goHome()"
        >
          🏠 MENU
        </button>
      </div>
    </div>
    <div class="controls-hint">
      Operator: <kbd>Spasi</kbd> Lihat/Kembali | <kbd>Enter</kbd> Acak |
      <kbd>Esc</kbd> Menu
    </div>

    <script src="ayat.js"></script>
    <script>
      // Fallback loader jika halaman dibuka dari parent folder (/tebak_tajwid) tanpa trailing slash
      if (typeof DATA === "undefined") {
        document.write('<script src="tebak_tajwid/ayat.js"><\/script>');
      }
    </script>
    <script>
      let order = [],
        idx = 0,
        curTask = "nun",
        flipped = false,
        isAnim = false,
        seen = 0;
      const els = {
        home: document.getElementById("home-screen"),
        game: document.getElementById("game-screen"),
        flip: document.getElementById("flip-card"),
        ayatF: document.getElementById("ayat-text"),
        wordsF: document.getElementById("words-front"),
        surahF: document.getElementById("surah-front"),
        instrF: document.getElementById("instr-front"),
        badgeF: document.getElementById("mode-badge"),
        ayatB: document.getElementById("ayat-text-back"),
        wordsB: document.getElementById("words-back"),
        surahB: document.getElementById("surah-back"),
        instrB: document.getElementById("instr-back"),
        explainB: document.getElementById("explain-back"),
        badgeB: document.getElementById("mode-badge-back"),
        counter: document.getElementById("counter-pill"),
        progress: document.getElementById("progress-bar"),
        qBoxF: document.getElementById("q-box-front"),
      };
      function shuffle(a) {
        return [...a].sort(() => Math.random() - 0.5);
      }
      function startGame() {
        if (typeof DATA === "undefined" || !Array.isArray(DATA) || DATA.length === 0) {
          alert("Gagal memuat data ayat (DATA belum tersedia). Silakan muat ulang halaman atau buka melalui http://.../tebak_tajwid/");
          return;
        }
        order = shuffle(DATA);
        idx = 0;
        seen = 0;
        flipped = false;
        els.flip.classList.remove("flipped");
        switchScreen(els.home, els.game);
        setTimeout(() => loadQuestion(), 300);
      }
      function goHome() {
        if (isAnim) return;
        flipped = false;
        els.flip.classList.remove("flipped");
        switchScreen(els.game, els.home);
      }
      function pickRandomTask() {
        return Math.random() < 0.5 ? "nun" : "idzhar";
      }
      function loadQuestion() {
        const q = order[idx];
        curTask = pickRandomTask();
        const isNun = curTask === "nun";
        const targets = isNun ? q.nun : q.idzhar;
        els.badgeF.textContent = isNun
          ? "🔍 CARI NUN SAKINAH"
          : "🔍 CARI IDZHAR";
        els.badgeF.className = "type-badge " + (isNun ? "nun" : "idzhar");
        els.ayatF.textContent = q.ayat;
        els.surahF.textContent = q.surah + " • Juz 30";
        seen++;
        els.counter.textContent = seen + " • " + q.surah;
        els.progress.style.width = ((seen % DATA.length) / DATA.length) * 100 + "%";
        els.instrF.textContent = isNun
          ? "👆 Sentuh kata yang ada نْ / tanwin (ـً ـٍ ـٌ)"
          : "👆 Sentuh kata yang IDZHAR (نْ/tanwin + ء ه ع ح غ خ)";
        els.instrF.style.background = "#f3f4f6";
        els.wordsF.innerHTML = "";
        q.words.forEach((w, i) => {
          const b = document.createElement("div");
          b.className = "word";
          b.textContent = w;
          b.id = "wf-" + i;
          b.onclick = () => handleGuess(i);
          els.wordsF.appendChild(b);
        });
        // back
        els.ayatB.textContent = q.ayat;
        els.surahB.textContent = q.surah + " • Juz 30";
        els.badgeB.textContent = isNun
          ? "JAWABAN • NUN SAKINAH"
          : "JAWABAN • IDZHAR";
        els.badgeB.style.background = isNun ? "var(--blue)" : "var(--green)";
        els.badgeB.style.color = isNun ? "#fff" : "#000";
        els.wordsB.innerHTML = "";
        q.words.forEach((w, i) => {
          const d = document.createElement("div");
          d.className = "word";
          const hit = targets.includes(i);
          if (hit)
            d.classList.add(isNun ? "highlight-nun" : "highlight-idzhar");
          else if (targets.length > 0) d.classList.add("dim");
          d.textContent = w;
          els.wordsB.appendChild(d);
        });
        if (targets.length === 0) {
          els.instrB.textContent =
            "🎯 TIDAK ADA — jebakan, tidak ada yang sesuai misi ini!";
          els.instrB.style.background = "#fee2e2";
        } else {
          els.instrB.textContent = isNun
            ? `✅ ${targets.length} kata mengandung Nun Sakinah/Tanwin`
            : `✅ ${targets.length} kata IDZHAR`;
          els.instrB.style.background = "var(--yellow)";
        }
        els.explainB.innerHTML =
          (isNun ? q.expNun : q.expIdzhar) +
          `<br><span style="opacity:.6;font-size:11px">${q.surah} • Idzhar: ء ه ع ح غ خ ${isNun ? "• Nun: نْ + tanwin ـً ـٍ ـٌ" : ""}</span>`;
        els.qBoxF.classList.remove("spinning");
      }
      function handleGuess(i) {
        const q = order[idx];
        const targets = curTask === "nun" ? q.nun : q.idzhar;
        const el = document.getElementById("wf-" + i);
        if (targets.includes(i)) {
          el.classList.add("correct");
          el.classList.remove("wrong");
          if (navigator.vibrate) navigator.vibrate(60);
        } else {
          el.classList.add("wrong");
          el.classList.add("shake");
          setTimeout(() => el.classList.remove("shake"), 300);
          els.instrF.textContent =
            "❌ Belum tepat — cek lagi huruf setelah نْ/tanwin!";
          els.instrF.style.background = "#fee2e2";
          setTimeout(() => (els.instrF.style.background = "#f3f4f6"), 800);
        }
      }
      function revealAnswer() {
        if (flipped || isAnim) return;
        flipped = true;
        els.flip.classList.add("flipped");
        launchConfetti();
      }
      function hideAnswer() {
        if (!flipped || isAnim) return;
        flipped = false;
        els.flip.classList.remove("flipped");
      }
      function spinNext() {
        if (isAnim) return;
        isAnim = true;
        if (flipped) {
          flipped = false;
          els.flip.classList.remove("flipped");
        }
        const box = els.qBoxF;
        box.classList.add("spinning");
        let c = 0,
          max = 16,
          iv = setInterval(() => {
            const r = DATA[Math.floor(Math.random() * DATA.length)];
            els.ayatF.textContent = r.ayat;
            els.ayatF.style.opacity = 0.25 + Math.random() * 0.4;
            els.wordsF.innerHTML = "";
            r.words.slice(0, 3).forEach((w) => {
              const d = document.createElement("div");
              d.className = "word";
              d.style.opacity = 0.45;
              d.textContent = w;
              els.wordsF.appendChild(d);
            });
            els.badgeF.textContent =
              Math.random() < 0.5 ? "🔍 CARI NUN SAKINAH" : "🔍 CARI IDZHAR";
            c++;
            if (c >= max) {
              clearInterval(iv);
              idx = (idx + 1) % order.length;
              if (idx === 0) order = shuffle(DATA);
              loadQuestion();
              els.ayatF.style.opacity = 1;
              box.classList.remove("spinning");
              isAnim = false;
            }
          }, 65);
      }
      function switchScreen(hide, show) {
        hide.style.opacity = 0;
        hide.style.transform = "translateY(-20px)";
        setTimeout(() => {
          hide.classList.remove("active");
          show.classList.add("active");
          void show.offsetWidth;
          show.style.opacity = 1;
          show.style.transform = "translateY(0)";
        }, 200);
      }
      function launchConfetti() {
        const c = document.getElementById("confetti");
        c.innerHTML = "";
        const cols = [
          "#FFD23F",
          "#22c55e",
          "#3b82f6",
          "#ff4d4d",
          "#a78bfa",
          "#f59e0b",
        ];
        for (let i = 0; i < 18; i++) {
          const e = document.createElement("i");
          e.style.left = Math.random() * 100 + "%";
          e.style.background = cols[Math.floor(Math.random() * cols.length)];
          e.style.transform = `rotate(${Math.random() * 360}deg)`;
          e.style.animationDelay = Math.random() * 0.25 + "s";
          e.style.borderRadius = Math.random() > 0.5 ? "50%" : "4px";
          c.appendChild(e);
        }
        setTimeout(() => (c.innerHTML = ""), 1200);
      }
      function triggerSim(el, fn) {
        el.classList.add("hover-sim");
        setTimeout(() => {
          el.classList.remove("hover-sim");
          fn();
        }, 150);
      }
      document.addEventListener("keydown", (e) => {
        if (isAnim) return;
        const homeActive = els.home.classList.contains("active");
        if (homeActive) {
          if (e.key === "Enter" || e.code === "Space") {
            e.preventDefault();
            triggerSim(document.getElementById("card-start"), () =>
              startGame(),
            );
          }
        } else {
          if (e.code === "Space") {
            e.preventDefault();
            flipped ? hideAnswer() : revealAnswer();
          }
          if (e.key === "Enter") {
            e.preventDefault();
            spinNext();
          }
          if (e.key === "Escape") {
            e.preventDefault();
            goHome();
          }
        }
      });
      els.progress.style.width = "0%";
    </script>
  </body>
</html>
</file>

