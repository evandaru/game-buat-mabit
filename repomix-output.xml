        correct: 0,
        selectedIndex: null,
        answered: false,
        choiceFocus: 0, // 0 idzhar, 1 bukan
      };

      const els = {
        menu: document.getElementById("view-menu"),
        tutorial: document.getElementById("view-tutorial"),
        game: document.getElementById("view-game"),
        result: document.getElementById("view-result"),
        ayatSurah: document.getElementById("ayat-surah"),
        words: document.getElementById("words"),
        caseBadge: document.getElementById("case-badge"),
        levelPill: document.getElementById("level-pill"),
        scorePill: document.getElementById("score-pill"),
        livesHearts: document.getElementById("lives-hearts"),
        instruction: document.getElementById("instruction"),
        suspectPanel: document.getElementById("suspect-panel"),
        suspectTitle: document.getElementById("suspect-title"),
        suspectDesc: document.getElementById("suspect-desc"),
        btnIdzhar: document.getElementById("btn-idzhar"),
        btnBukan: document.getElementById("btn-bukan"),
        progressBar: document.getElementById("progress-bar"),
        feedback: document.getElementById("feedback"),
        overlay: document.getElementById("overlay"),
        fbIcon: document.getElementById("fb-icon"),
        fbTitle: document.getElementById("fb-title"),
        fbMsg: document.getElementById("fb-msg"),
        fbDetail: document.getElementById("fb-detail"),
        fbPoint: document.getElementById("fb-point"),
        resultScore: document.getElementById("result-score"),
        resultDetail: document.getElementById("result-detail"),
        resultRank: document.getElementById("result-rank"),
      };

      function showView(name) {
        state.view = name;
        document
          .querySelectorAll(".view")
          .forEach((v) => v.classList.remove("active"));
        if (name === "MENU") els.menu.classList.add("active");
        if (name === "TUTORIAL") els.tutorial.classList.add("active");
        if (name === "PLAYING") els.game.classList.add("active");
        if (name === "RESULT") els.result.classList.add("active");
        // focus management
        if (name === "MENU") document.getElementById("btn-mulai").focus();
        if (name === "TUTORIAL") document.getElementById("tut-next").focus();
        if (name === "PLAYING" && !els.feedback.classList.contains("show")) {
          // keep focus on choices if selected
          if (state.selectedIndex !== null) els.btnIdzhar.focus();
        }
        if (name === "RESULT") document.getElementById("btn-replay").focus();
      }

      function updateHUD() {
        els.scorePill.textContent = `SKOR: ${state.score}`;
        const hearts = [1, 2, 3]
          .map((i) => (i <= state.lives ? "♥" : "♡"))
          .join(" ");
        els.livesHearts.innerHTML = hearts
          .split(" ")
          .map((h, idx) => {
            const alive = idx < state.lives;
            return `<span class="${alive ? "" : "dead"}">${h}</span>`;
          })
          .join(" ");
        const pct = (state.qIndex / QUESTIONS.length) * 100;
        els.progressBar.style.width = pct + "%";
      }

      function loadQuestion() {
        const q = QUESTIONS[state.qIndex];
        if (!q) {
          showResult();
          return;
        }
        els.caseBadge.textContent = `KASUS #${String(q.id).padStart(2, "0")}`;
        els.levelPill.textContent = `KASUS #${String(q.id).padStart(2, "0")} — LEVEL ${q.level} • Juz 30`;
        els.ayatSurah.textContent = `${q.surah} • Juz 30`;
        els.words.innerHTML = "";
        q.words.forEach((w, idx) => {
          const b = document.createElement("button");
          b.className = "word";
          b.type = "button";
          b.textContent = w;
          b.dataset.index = idx;
          b.setAttribute("aria-label", `Kata ${idx + 1}: ${w}`);
          b.addEventListener("click", () => selectWord(idx));
          els.words.appendChild(b);
        });
        state.selectedIndex = null;
        state.answered = false;
        state.choiceFocus = 0;
        els.suspectPanel.style.display = "none";
        els.instruction.textContent =
          "TEMUKAN PETUNJUKNYA — Klik bagian yang ada Nun Sakinah / Tanwin";
        els.instruction.style.color = "";
        els.btnIdzhar.disabled = true;
        els.btnBukan.disabled = true;
        els.btnIdzhar.classList.remove("selected");
        els.btnBukan.classList.remove("selected");
        updateChoiceFocus();
        updateHUD();
      }

      function selectWord(idx) {
        const q = QUESTIONS[state.qIndex];
        state.selectedIndex = idx;
        [...els.words.children].forEach((c) => c.classList.remove("selected"));
        els.words.children[idx].classList.add("selected");
        // check if correct target
        if (idx === q.targetIndex) {
          els.suspectPanel.style.display = "block";
          els.suspectTitle.textContent = "TERSANGKA DITEMUKAN ✓";
          els.suspectDesc.innerHTML = `<span style="font-family:'Scheherazade New',serif;font-size:20px">${q.targetLabel}</span> — Sekarang periksa huruf setelahnya: <b style="font-family:'Scheherazade New',serif;font-size:18px">${q.after}</b>`;
          els.instruction.textContent =
            "Bagus! Sekarang putuskan: apakah ini IDZHAR?";
          els.instruction.style.color = "#15803d";
          els.btnIdzhar.disabled = false;
          els.btnBukan.disabled = false;
          updateChoiceFocus();
          els.btnIdzhar.focus();
        } else {
          els.suspectPanel.style.display = "block";
          els.suspectTitle.textContent = "BELUM TEPAT";
          els.suspectDesc.textContent =
            "Itu bukan lokasi Nun Sakinah / Tanwin. Coba periksa kata lain — cari نْ atau tanwin (ــً ــٍ ــٌ).";
          els.instruction.textContent =
            "Coba klik kata lain — cari نْ / tanwin";
          els.instruction.style.color = "#b45309";
          // do not enable answer buttons if wrong selection
          els.btnIdzhar.disabled = true;
          els.btnBukan.disabled = true;
        }
      }

      function updateChoiceFocus() {
        els.btnIdzhar.classList.toggle(
          "selected",
          state.choiceFocus === 0 && !els.btnIdzhar.disabled,
        );
        els.btnBukan.classList.toggle(
          "selected",
          state.choiceFocus === 1 && !els.btnBukan.disabled,
        );
      }

      function answer(hukum) {
        if (state.selectedIndex === null) {
          els.instruction.textContent =
            "Pilih dulu tersangkanya — klik kata yang mengandung نْ / tanwin!";
          els.instruction.style.color = "#dc2626";
          els.words.animate(
            [
              { transform: "translateX(0)" },
              { transform: "translateX(-6px)" },
              { transform: "translateX(6px)" },
              { transform: "translateX(0)" },
            ],
            { duration: 300 },
          );
          return;
        }
        // ensure selected is correct target; if wrong target but they forced answer via keyboard, block
        const q = QUESTIONS[state.qIndex];
        if (state.selectedIndex !== q.targetIndex) {
          els.instruction.textContent =
            "Tersangka belum tepat — pilih kata yang benar dulu.";
          return;
        }
        if (state.answered) return;
        state.answered = true;
        const correct = hukum === q.hukum;
        if (correct) {
          state.score += 10;
          state.correct += 1;
          showFeedback(true, q);
        } else {
          state.lives -= 1;
          showFeedback(false, q);
        }
        updateHUD();
      }

      function showFeedback(isCorrect, q) {
        els.overlay.classList.add("show");
        els.feedback.classList.add("show");
        if (isCorrect) {
          els.fbIcon.textContent = "✅";
          els.fbTitle.textContent = "BENAR!";
          els.fbTitle.style.color = "#15803d";
          els.fbMsg.textContent = `Detektif menemukan petunjuk! • ${q.surah}`;
          els.fbDetail.innerHTML = `<span style="font-family:'Scheherazade New',serif">${q.targetLabel} + ${q.after}</span> — <b>${q.after}</b> termasuk huruf Idzhar.<br/><span style="font-size:11px;opacity:0.7;letter-spacing:0.06em">${q.surah} • ${q.explanation}</span>`;
          els.fbDetail.style.direction = "rtl";
          els.fbPoint.textContent = "+10 POIN";
          els.fbPoint.style.color = "#15803d";
        } else {
          els.fbIcon.textContent = "🔎";
          els.fbTitle.textContent = "BELUM TEPAT!";
          els.fbTitle.style.color = "#dc2626";
          els.fbMsg.textContent = `Coba periksa kembali huruf setelah Nun Sakinah / Tanwin. • ${q.surah}`;
          if (q.hukum === "idzhar") {
            els.fbDetail.innerHTML = `<span style="font-family:'Scheherazade New',serif">${q.targetLabel} + ${q.after}</span> — seharusnya <b>IDZHAR</b> karena ${q.after} ∈ { ء ه ع ح غ خ }<br/><span style="font-size:11px;opacity:0.7">${q.surah}</span>`;
          } else {
            els.fbDetail.innerHTML = `<span style="font-family:'Scheherazade New',serif">${q.targetLabel} + ${q.after}</span> — <b>BUKAN IDZHAR</b>. ${q.explanation}<br/><span style="font-size:11px;opacity:0.7">${q.surah}</span>`;
          }
          els.fbDetail.style.direction = "rtl";
          els.fbPoint.textContent =
            q.hukum === "idzhar"
              ? "Petunjuk: ء ه ع ح غ خ"
              : "Petunjuk: ء ه ع ح غ خ — jika tidak ada, bukan Idzhar";
          els.fbPoint.style.color = "#6b7280";
        }
        document.getElementById("fb-next").focus();
      }

      function closeFeedback() {
        els.overlay.classList.remove("show");
        els.feedback.classList.remove("show");
        if (state.lives <= 0) {
          showResult(true);
          return;
        }
        state.qIndex += 1;
        if (state.qIndex >= QUESTIONS.length) {
          showResult();
        } else {
          loadQuestion();
        }
      }

      function showResult(isGameOver = false) {
        showView("RESULT");
        els.resultScore.textContent = state.score;
        els.resultDetail.textContent = `${state.correct} / ${QUESTIONS.length} KASUS TERPECAHKAN${isGameOver ? " — NYAWA HABIS" : ""}`;
        let rank = "DETEKTIF PEMULA";
        if (state.correct >= 9) rank = "MASTER DETEKTIF 🌟";
        else if (state.correct >= 7) rank = "DETEKTIF HEBAT";
        else if (state.correct >= 4) rank = "DETEKTIF TAJWID";
        else if (state.correct >= 1) rank = "DETEKTIF MAGANG";
        els.resultRank.textContent = rank;
        els.progressBar.style.width = "100%";
      }

      function resetGame() {
        state.qIndex = 0;
        state.score = 0;
        state.lives = 3;
        state.correct = 0;
        state.selectedIndex = null;
        state.answered = false;
        state.choiceFocus = 0;
        loadQuestion();
        showView("PLAYING");
        updateHUD();
      }

      // Menu events — MULAI langsung ke game (tanpa tutorial) untuk mode proyektor
      document.getElementById("btn-mulai").addEventListener("click", () => {
        resetGame();
      });
      document.getElementById("btn-cara").addEventListener("click", () => {
        state.tutStep = 0;
        updateTutorial();
        showView("TUTORIAL");
      });
      document
        .getElementById("btn-game-menu")
        .addEventListener("click", () => showView("MENU"));
      document
        .getElementById("btn-replay")
        .addEventListener("click", () => resetGame());
      document
        .getElementById("btn-to-menu")
        .addEventListener("click", () => showView("MENU"));

      // Tutorial
      function updateTutorial() {
        document
          .querySelectorAll(".tut-step")
          .forEach((s) =>
            s.classList.toggle(
              "active",
              Number(s.dataset.step) === state.tutStep,
            ),
          );
        document
          .querySelectorAll(".dot")
          .forEach((d, i) => d.classList.toggle("active", i === state.tutStep));
        const atLast = state.tutStep === 4;
        document.getElementById("tut-next").style.display = atLast
          ? "none"
          : "inline-flex";
        document.getElementById("tut-prev").style.display =
          state.tutStep === 0 ? "none" : "inline-flex";
        document.getElementById("tut-start").style.display = atLast
          ? "inline-flex"
          : "none";
        if (atLast) document.getElementById("tut-start").focus();
      }
      document.getElementById("tut-next").addEventListener("click", () => {
        if (state.tutStep < 4) {
          state.tutStep++;
          updateTutorial();
        }
      });
      document.getElementById("tut-prev").addEventListener("click", () => {
        if (state.tutStep > 0) {
          state.tutStep--;
          updateTutorial();
        }
      });
      document.getElementById("tut-start").addEventListener("click", () => {
        resetGame();
      });

      // Game choice events
      document
        .getElementById("btn-idzhar")
        .addEventListener("click", () => answer("idzhar"));
      document
        .getElementById("btn-bukan")
        .addEventListener("click", () => answer("bukan"));
      document
        .getElementById("fb-next")
        .addEventListener("click", closeFeedback);
      document
        .getElementById("overlay")
        .addEventListener("click", closeFeedback);

      // Keyboard
      document.addEventListener("keydown", (e) => {
        // global shortcuts
        if (e.key === " " || e.code === "Space") {
          if (
            state.view === "TUTORIAL" &&
            els.feedback.classList.contains("show") == false
          ) {
            e.preventDefault();
            if (state.tutStep === 0) showView("MENU");
            else {
              state.tutStep = Math.max(0, state.tutStep - 1);
              updateTutorial();
            }
          } else if (state.view === "PLAYING") {
            if (els.feedback.classList.contains("show")) {
              e.preventDefault();
              closeFeedback();
            } else {
              e.preventDefault();
              showView("MENU");
            }
          } else if (state.view === "RESULT") {
            e.preventDefault();
            showView("MENU");
          }
        }
        if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
          if (state.view === "MENU") {
            e.preventDefault();
            const m = document.getElementById("btn-mulai"),
              c = document.getElementById("btn-cara");
            if (document.activeElement === m) c.focus();
            else m.focus();
          } else if (
            state.view === "TUTORIAL" &&
            !els.feedback.classList.contains("show")
          ) {
            e.preventDefault();
            if (e.key === "ArrowRight" && state.tutStep < 4) {
              state.tutStep++;
              updateTutorial();
            }
            if (e.key === "ArrowLeft" && state.tutStep > 0) {
              state.tutStep--;
              updateTutorial();
            }
          } else if (
            state.view === "PLAYING" &&
            !els.feedback.classList.contains("show") &&
            state.selectedIndex !== null
          ) {
            e.preventDefault();
            state.choiceFocus = e.key === "ArrowLeft" ? 0 : 1;
            updateChoiceFocus();
            (state.choiceFocus === 0 ? els.btnIdzhar : els.btnBukan).focus();
          } else if (state.view === "RESULT") {
            e.preventDefault();
            const a = document.getElementById("btn-replay"),
              b = document.getElementById("btn-to-menu");
            if (document.activeElement === a) b.focus();
            else a.focus();
          }
        }
        if (e.key === "Enter") {
          if (state.view === "MENU") {
            e.preventDefault();
            if (
              document.activeElement === document.getElementById("btn-cara")
            ) {
              state.tutStep = 0;
              updateTutorial();
              showView("TUTORIAL");
            } else {
              resetGame();
            }
          } else if (state.view === "TUTORIAL") {
            e.preventDefault();
            if (state.tutStep < 4) {
              state.tutStep++;
              updateTutorial();
            } else resetGame();
          } else if (state.view === "PLAYING") {
            if (els.feedback.classList.contains("show")) {
              e.preventDefault();
              closeFeedback();
            } else if (state.selectedIndex !== null) {
              e.preventDefault();
              // if focus is on a button, use that
              if (document.activeElement === els.btnBukan) answer("bukan");
              else if (document.activeElement === els.btnIdzhar)
                answer("idzhar");
              else answer(state.choiceFocus === 0 ? "idzhar" : "bukan");
            } else {
              // try to trigger instruction shake via Enter as well
              e.preventDefault();
              answer(state.choiceFocus === 0 ? "idzhar" : "bukan");
            }
          } else if (state.view === "RESULT") {
            e.preventDefault();
            if (
              document.activeElement === document.getElementById("btn-to-menu")
            )
              showView("MENU");
            else resetGame();
          }
        }
        if (e.key === "Escape") {
          if (els.feedback.classList.contains("show")) closeFeedback();
          else if (state.view === "PLAYING") showView("MENU");
          else if (state.view === "TUTORIAL") showView("MENU");
          else if (state.view === "RESULT") showView("MENU");
        }
      });

      // Tooltip Kartu Bukti
      (function () {
        const trig = document.getElementById("hint-trigger");
        const tip = document.getElementById("hint-tooltip");
        if (!trig || !tip) return;
        let pinned = false;
        const show = () => (tip.style.display = "block");
        const hide = () => {
          if (!pinned) tip.style.display = "none";
        };
        trig.addEventListener("mouseenter", show);
        trig.addEventListener("mouseleave", hide);
        trig.addEventListener("focus", show);
        trig.addEventListener("blur", hide);
        trig.addEventListener("click", (e) => {
          e.preventDefault();
          pinned = !pinned;
          tip.style.display = pinned ? "block" : "none";
          trig.setAttribute("aria-expanded", String(pinned));
        });
        // klik di luar untuk tutup
        document.addEventListener("click", (e) => {
          if (!trig.contains(e.target) && !tip.contains(e.target)) {
            pinned = false;
            tip.style.display = "none";
            trig.setAttribute("aria-expanded", "false");
          }
        });
      })();

      // Init
      updateHUD();
      updateTutorial();
    </script>
  </body>
</html>
</file>

