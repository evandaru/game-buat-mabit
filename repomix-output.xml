<file path="truth_or_dare/index.html">
<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truth or Dare - Bahasa Indonesia</title>
    <!-- SEO Best Practices -->
    <meta name="description" content="Aplikasi interaktif Truth or Dare Bahasa Indonesia untuk Mabit kelas 5">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #000000;
            --border-color: #000000;
            --hover-color: #f3f4f6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Outfit', sans-serif;
            user-select: none;
        }

        body {
            background: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* Minimalist Background Pattern */
        body::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(#d1d5db 1px, transparent 1px);
            background-size: 30px 30px;
            opacity: 0.5;
            z-index: 0;
        }

        #app {
            position: relative;
            z-index: 10;
            width: 90%;
            max-width: 1400px;
            text-align: center;
        }

        /* Screens */
        .screen {
            display: none;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s ease;
        }

        .screen.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        /* Home Screen */
        .title {
            font-size: 6vw;
            font-weight: 900;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            line-height: 1;
            color: var(--text-color);
        }

        .subtitle {
            font-size: 2vw;
            font-weight: 600;
            margin-top: 1rem;
            margin-bottom: 4rem;
            color: #4b5563;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .cards-container {
            display: flex;
            gap: 4vw;
            justify-content: center;
            padding: 0 2rem;
            flex-wrap: wrap;
        }

        .card {
            flex: 1;
            min-width: 300px;
            max-width: 500px;
            height: 45vh;
            min-height: 350px;
            background: var(--bg-color);
            border: 4px solid var(--border-color);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 12px 12px 0px var(--border-color);
        }

        .card:hover,
        .card.hover-sim {
            transform: translate(-6px, -6px);
            box-shadow: 18px 18px 0px var(--border-color);
            background: var(--hover-color);
        }

        .card:active {
            transform: translate(6px, 6px);
