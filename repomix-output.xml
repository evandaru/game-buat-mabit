<body>
    <div id="app">
        <!-- Home Screen -->
        <div id="home-screen" class="screen active">
            <div class="cards-container">
                <div class="card" onclick="selectType('truth')" id="btn-truth">
                    <h2>TRUTH</h2>

                </div>
                <div class="card" onclick="selectType('dare')" id="btn-dare">
                    <h2>DARE</h2>

                </div>
            </div>
        </div>

        <!-- Question Screen -->
        <div id="question-screen" class="screen">
            <div class="question-container" id="question-box">
                <div class="type-badge" id="question-type-badge">TRUTH</div>
                <div id="question-text">Menyiapkan...</div>
                <button class="btn-back" id="btn-back" onclick="goBack()">Kembali</button>
            </div>
        </div>
    </div>

    <div class="controls-hint">
        Operator: <kbd>←</kbd> Truth | <kbd>→</kbd> Dare | <kbd>Spasi</kbd> Kembali
    </div>

    <!-- Load data file -->
    <script src="data.js"></script>
    <script>
        const homeScreen = document.getElementById('home-screen');
        const questionScreen = document.getElementById('question-screen');
        const questionText = document.getElementById('question-text');
        const questionBadge = document.getElementById('question-type-badge');

        const btnTruth = document.getElementById('btn-truth');
        const btnDare = document.getElementById('btn-dare');

        let isAnimating = false;
        let currentScreen = 'home'; // 'home' or 'question'

        // Data arrays from data.js
        let availableTruths = [...truthQuestions];
        let availableDares = [...dareQuestions];

        // Keyboard Controls
        document.addEventListener('keydown', (e) => {
            if (isAnimating) return;

            if (currentScreen === 'home') {
                if (e.key === 'ArrowLeft') {
                    triggerButtonSim(btnTruth, 'truth');
                } else if (e.key === 'ArrowRight') {
                    triggerButtonSim(btnDare, 'dare');
                }
            } else if (currentScreen === 'question') {
                if (e.key === ' ' || e.key === 'Escape' || e.key === 'Backspace' || e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById('btn-back').focus();
                    goBack();
                }
            }
        });

        function triggerButtonSim(btn, type) {
            btn.classList.add('hover-sim');
            setTimeout(() => {
                btn.classList.remove('hover-sim');
                selectType(type);
            }, 150);
        }

        function selectType(type) {
            if (isAnimating) return;
            isAnimating = true;

            // Setup Screen
            if (type === 'truth') questionBadge.textContent = 'TRUTH';
            if (type === 'dare') questionBadge.textContent = 'DARE';

            // Hide Home, Show Question Box
            switchScreen(homeScreen, questionScreen);
            currentScreen = 'question';

            // Start shuffle animation
            shuffleText(type);
        }

        function goBack() {
            if (isAnimating) return;
            isAnimating = true;

            switchScreen(questionScreen, homeScreen);
            currentScreen = 'home';
            document.getElementById('btn-back').blur();

            setTimeout(() => {
                isAnimating = false;
            }, 300);
        }

        function switchScreen(hideEl, showEl) {
            hideEl.style.opacity = 0;
            hideEl.style.transform = 'translateY(-20px)';

            setTimeout(() => {
                hideEl.classList.remove('active');
                showEl.classList.add('active');

                void showEl.offsetWidth; // Trigger reflow

                showEl.style.opacity = 1;
                showEl.style.transform = 'translateY(0)';
            }, 200);
        }

        function getQuestion(type) {
            let list;

            if (type === 'truth') {
                list = availableTruths;
            } else {
                list = availableDares;
            }

            // If empty, reset list
            if (list.length === 0) {
                if (type === 'truth') availableTruths = [...truthQuestions];
                if (type === 'dare') availableDares = [...dareQuestions];
                list = type === 'truth' ? availableTruths : availableDares;
            }

            const randomIndex = Math.floor(Math.random() * list.length);
            const question = list[randomIndex];

            list.splice(randomIndex, 1);
            return question;
        }

        function getRandomItemForShuffle(type) {
            const list = type === 'truth' ? truthQuestions : dareQuestions;
            return list[Math.floor(Math.random() * list.length)];
        }

        function shuffleText(type) {
            let counter = 0;
            const maxShuffles = 20;
            const intervalTime = 50;

            const interval = setInterval(() => {
                questionText.textContent = getRandomItemForShuffle(type);
                questionText.style.opacity = 0.3 + (Math.random() * 0.4);

                counter++;

                if (counter >= maxShuffles) {
                    clearInterval(interval);

                    const finalQuestion = getQuestion(type);
                    questionText.textContent = finalQuestion;

                    // Final reveal style
                    questionText.style.opacity = 1;

                    isAnimating = false;
                }
            }, intervalTime);
        }
    </script>
</body>

</html>
