    <script>
        const setupPage = document.getElementById('setup-page');
        const spinPage = document.getElementById('spin-page');
        const resultPage = document.getElementById('result-page');
        
        const spinBtn = document.getElementById('spinBtn');
        const resetBtn = document.getElementById('resetBtn');
        const namesInput = document.getElementById('namesInput');
        const spinText = document.getElementById('spinText');
        const resultList = document.getElementById('resultList');

        let rawNames = [];

        // Muat dari localStorage saat pertama kali halaman dibuka
        const savedNames = localStorage.getItem('savedWheelNames');
        if (savedNames) {
            namesInput.value = savedNames;
        }

        // Simpan setiap kali ada perubahan pada teks
        namesInput.addEventListener('input', () => {
            localStorage.setItem('savedWheelNames', namesInput.value);
        });

        spinBtn.addEventListener('click', () => {
            // Ambil nama dari input
            rawNames = namesInput.value.split('\n').map(n => n.trim()).filter(n => n !== '');
            if (rawNames.length === 0) {
                alert("Tolong masukkan minimal 1 nama!");
                return;
            }

            // Ganti ke halaman animasi
            setupPage.style.display = 'none';
            spinPage.style.display = 'flex';

            // Animasi pergantian teks secara cepat di tengah lingkaran
            let flashInterval = setInterval(() => {
                const randomName = rawNames[Math.floor(Math.random() * rawNames.length)];
                spinText.innerText = randomName;
            }, 80);

            // Tunggu animasi popInOut CSS selesai (sekitar 3.5 detik)
            setTimeout(() => {
                clearInterval(flashInterval);
                tampilkanHasil();
            }, 3300);
        });

        function tampilkanHasil() {
            spinPage.style.display = 'none';
            resultPage.style.display = 'flex';

            // Acak urutan array menggunakan Fisher-Yates Shuffle
            let shuffled = [...rawNames];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }

            // Bersihkan list sebelumnya
            resultList.innerHTML = '';

            // Masukkan elemen ke dalam list dengan jeda animasi (stagger)
            shuffled.forEach((name, i) => {
                const li = document.createElement('li');
                li.className = 'result-item';
                // Tambahkan jeda animasi agar munculnya satu-satu (menurun)
                li.style.animationDelay = `${i * 0.15}s`;
                li.innerHTML = `<span class="rank">#${i + 1}</span> <span class="name">${name}</span>`;
                resultList.appendChild(li);
            });

            // Tembakkan Confetti untuk merayakan
            fireConfetti();
        }

        resetBtn.addEventListener('click', () => {
            resultPage.style.display = 'none';
            setupPage.style.display = 'flex';
        });

        function fireConfetti() {
            const duration = 3000;
            const end = Date.now() + duration;

            (function frame() {
                confetti({
                    particleCount: 8,
                    angle: 60,
                    spread: 80,
                    origin: { x: 0 },
                    colors: ['#ff007f', '#ffaa00', '#00ffff']
                });
                confetti({
                    particleCount: 8,
                    angle: 120,
                    spread: 80,
                    origin: { x: 1 },
                    colors: ['#ff007f', '#ffaa00', '#00ffff']
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            }());
        }
    </script>
</body>
</html>
