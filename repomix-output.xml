<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Red Light Green Light - Proyektor</title>
    <script>
        // Normalisasi URL Vercel agar relative path 'img/...' dan 'sound/...' tidak 404
        if (window.location.pathname && !window.location.pathname.endsWith('/') && !window.location.pathname.includes('.')) {
            window.location.replace(window.location.pathname + '/' + window.location.search + window.location.hash);
        }
    </script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            font-family: system-ui, -apple-system, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #111;
            color: white;
            user-select: none;
        }

        #screen {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

        #status {
            font-size: clamp(4rem, 18vw, 12rem);
            font-weight: 900;
            letter-spacing: 4px;
            text-align: center;
            line-height: 1.1;
            text-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        }

        #sub {
            font-size: clamp(1.2rem, 4vw, 2.5rem);
            margin-top: 20px;
            opacity: 0.9;
            font-weight: 600;
        }

        .green #screen {
            background: #1B5E20;
        }

        .red #screen {
            background: #B71C1C;
        }

        .idle #screen {
            background: #212121;
        }

        #stateImg {
            max-width: 80vw;
            max-height: 48vh;
            object-fit: contain;
            border-radius: 20px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
            margin-bottom: 24px;
            display: none;
            transition: transform 0.2s ease;
        }

        #startBtn {
            position: absolute;
            bottom: 40px;
            padding: 18px 48px;
            font-size: 1.6rem;
            font-weight: 700;
            border: none;
            border-radius: 60px;
            background: #2196F3;
            color: white;
            cursor: pointer;
            box-shadow: 0 6px 0 #1565C0;
        }

        #startBtn:active {
            transform: translateY(4px);
            box-shadow: none;
        }

        #timer {
            position: absolute;
            top: 24px;
            font-size: 1.4rem;
            opacity: 0.7;
        }
    </style>
</head>

<body class="idle">
    <div id="screen">
        <img id="stateImg" src="" alt="Squid Game Visual">
        <div id="status">SIAP?</div>
        <div id="sub">Klik tombol untuk mulai</div>
    </div>

    <div id="timer"></div>
    <button id="startBtn">▶ MULAI PERMAINAN</button>

    <script>
        const body = document.body;
        const statusEl = document.getElementById('status');
        const subEl = document.getElementById('sub');
        const startBtn = document.getElementById('startBtn');
        const timerEl = document.getElementById('timer');
        const stateImg = document.getElementById('stateImg');

        // Helper untuk memastikan path aset (gambar & suara) selalu benar di Vercel
        function getAssetPath(relPath) {
            const path = window.location.pathname;
            if (!path.endsWith('/') && !path.includes('.')) {
                const seg = path.substring(path.lastIndexOf('/') + 1);
                return seg + '/' + relPath;
            }
            return relPath;
        }

        const imgStartPath = getAssetPath('img/start.jpg');
        const imgStopPath = getAssetPath('img/stop.jpg');
        const startSoundPath = getAssetPath('sound/start.mp3');
        const stopSoundPath = getAssetPath('sound/stop.mp3');

        // Preload gambar agar tidak patah/delay saat ganti fase
        const imgStart = new Image();
        imgStart.src = imgStartPath;
        const imgStop = new Image();
        imgStop.src = imgStopPath;

        let isPlaying = false;
        let switchTimer = null;
        let startTime = 0;
        let timerInterval = null;

        // --- PENGATURAN DURASI (DALAM MILIDETIK) ---
        // Hijau: 20 sampai 35 detik (waktu menyusun sedotan)
        function greenDelay() {
            return 20000 + Math.random() * 15000;
        }

        // Merah: 8 sampai 15 detik (waktu diam / freeze)
        function redDelay() {
            return 8000 + Math.random() * 7000;
        }

        // --- AUDIO EFEK ---
        const startSound = new Audio(startSoundPath);
        const stopSound = new Audio(stopSoundPath);
        startSound.volume = 0.3; // Volume start lebih lembut
        stopSound.volume = 1.0;  // Volume stop 100% full (sangat kencang)

        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                try {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {
                    console.log('Web Audio setup error:', e);
                }
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playStartSound() {
            initAudio();
            try {
                stopSound.pause();
                stopSound.currentTime = 0;
                startSound.currentTime = 0;
                startSound.play().catch(e => console.log('Audio play error:', e));
            } catch (e) {}
        }

        function playStopSound() {
            initAudio();
            try {
                startSound.pause();
                startSound.currentTime = 0;
                stopSound.currentTime = 0;
                stopSound.play().catch(e => console.log('Audio play error:', e));
            } catch (e) {}
        }

        function setGreen() {
            body.className = 'green';
            statusEl.textContent = 'GASSS';
            subEl.textContent = 'OTW NIHH BOSSS😂';

            stateImg.src = imgStartPath;
            stateImg.style.display = 'block';

            // Mainkan suara Start
            playStartSound();

            // Jadwalkan kapan ganti ke MERAH
            scheduleNext(greenDelay(), setRed);
        }

        function setRed() {
            body.className = 'red';
            statusEl.textContent = 'DIAMMM';
            subEl.textContent = 'AWAS KAKI SAYA SAKIT😭';

            stateImg.src = imgStopPath;
            stateImg.style.display = 'block';

            // Mainkan suara Stop
            playStopSound();

            // Jadwalkan kapan ganti ke HIJAU
            scheduleNext(redDelay(), setGreen);
        }

        function scheduleNext(delay, nextFunction) {
            clearTimeout(switchTimer);
            switchTimer = setTimeout(() => {
                if (!isPlaying) return;
                nextFunction();
            }, delay);
        }

        function updateTimer() {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            const m = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const s = String(elapsed % 60).padStart(2, '0');
            timerEl.textContent = `${m}:${s}`;
        }

        function startGame() {
            isPlaying = true;
            startBtn.style.display = 'none';
            startTime = Date.now();
            timerInterval = setInterval(updateTimer, 1000);
            updateTimer();

            // Mulai langsung dengan fase Hijau
            setGreen();
        }

        function stopGame() {
            isPlaying = false;
            clearTimeout(switchTimer);
            clearInterval(timerInterval);
            startSound.pause();
            startSound.currentTime = 0;
            stopSound.pause();
            stopSound.currentTime = 0;
            stateImg.style.display = 'none';
            body.className = 'idle';
            statusEl.textContent = 'SELESAI';
            subEl.textContent = 'Tekan F5 untuk mulai ulang';
            startBtn.style.display = 'none';
        }

        startBtn.addEventListener('click', startGame);

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isPlaying) {
                stopGame();
            }
        });
    </script>
</body>

</html>
</file>

